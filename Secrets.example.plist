<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Copy to MyPharmacist/Resources/Secrets.plist (git ignores that path) and paste your OpenAI
  API key below. Without a key the app recognizes pills on the device instead.
  The key ends up inside the app, so use this only for demo builds on your own phones.
-->
<plist version="1.0">
<dict>
	<key>OPENAI_API_KEY</key>
	<string>sk-paste-your-key-here</string>
	<key>OPENAI_MODEL</key>
	<string>gpt-6.1-sol</string>
</dict>
</plist>
