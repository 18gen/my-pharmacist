<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Copy to MyPharmacist/Resources/Secrets.plist (git ignores that path) and fill in the pill
  check server's address and the app token you set on it (server/pill-check/README.md).
  The OpenAI key stays on the server; it is never in the app. Without these, pills can't be
  checked and a scan asks to try again.

  PHARMACY_URL and PHARMACY_TOKEN are the pharmacy demo's dashboard (the
  my-pharmacist-dashboard project) and the APP_TOKEN set on it. Without them, the app has no
  "Share with the pharmacy demo" at all.
-->
<plist version="1.0">
<dict>
	<key>PILL_CHECK_URL</key>
	<string>https://my-pharmacist-pill-check.YOUR-SUBDOMAIN.workers.dev</string>
	<key>PILL_CHECK_TOKEN</key>
	<string>paste-your-app-token-here</string>
	<key>PHARMACY_URL</key>
	<string>https://YOUR-DASHBOARD.vercel.app</string>
	<key>PHARMACY_TOKEN</key>
	<string>paste-the-dashboards-app-token-here</string>
</dict>
</plist>
